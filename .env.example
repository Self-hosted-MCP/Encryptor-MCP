# Settings for encryptor-mcp. On a computer: ~/.config/encryptor-mcp/.env. On a server: next to docker-compose.yml.
# Everything here is optional except the web version's passphrase. The control center can set most of it too, and
# whatever you change there wins over this file.

# Vaults, as Name=/path/to/vault;Other=/path/to/other (or add them on the control center: Settings > Add a vault)
# ENCRYPTOR_VAULTS=Taxes=~/Nextcloud/Taxes;Notes=~/Dropbox/Notes

# What the AI may do with each (full = read and change, read, hidden). Default: full.
# ENCRYPTOR_MODES=Notes=read

# Lock a vault after this many minutes without use (default 10), and never keep one open longer than this (12 h)
# ENCRYPTOR_IDLE_MINUTES=10
# ENCRYPTOR_MAX_HOURS=12

# Read only for every AI app, fixed (the control center can't turn it off)
# ENCRYPTOR_READ_ONLY=yes

# ---- the web version (encryptor-mcp serve, or Docker) ----
# The address people and AI apps use (must be https on the internet)
# ENCRYPTOR_DOMAIN=vault.example.com
# PUBLIC_URL=https://vault.example.com
# The passphrase for the control center and for connecting AI apps (8+ characters)
LOGIN_PASSPHRASE=
# or, instead, its hash from "encryptor-mcp set-passphrase":
# LOGIN_HASH=
