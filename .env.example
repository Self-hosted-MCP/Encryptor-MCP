# Settings for encryptor-mcp. On a computer: ~/.config/encryptor-mcp/.env. On a server with Docker Compose: next to
# docker-compose.yml (Compose passes them in; set-passphrase writes LOGIN_HASH to /data/.env inside the volume).
# Everything here is optional except the web version's passphrase. The control center can set most of it too, and
# whatever you change there wins over this file. Every setting is explained in docs/settings.md.

# ---- vaults ----
# Vaults, as Name=/path/to/vault;Other=/path/to/other (or add them on the control center: Settings > Add a vault)
# ENCRYPTOR_VAULTS=Taxes=~/Nextcloud/Taxes;Notes=~/Dropbox/Notes

# What the AI may do with each (full = read and change, read, hidden). Default: full. Unknown words become read.
# ENCRYPTOR_MODES=Notes=read

# ---- unlocking and auto-lock ----
# Lock a vault after this many minutes without use (default 10), and never keep one open longer than this (12 h)
# ENCRYPTOR_IDLE_MINUTES=10
# ENCRYPTOR_MAX_HOURS=12

# How you're asked for the password: auto (the app opens the unlock page, else a Mac password box, else a link),
# page, box or link. Default: auto
# ENCRYPTOR_UNLOCK=auto

# ---- approvals ----
# Also ask you before these, comma separated: replace, trash, move. Default: none (every change can be undone anyway)
# ENCRYPTOR_ASK_BEFORE=replace,trash,move

# How you approve: auto (a Mac box, else the AI app's own question, else a one-time code in the chat), box, ask or
# code. Deleting for good is never approved with a code in the chat. Default: auto
# ENCRYPTOR_APPROVE=auto

# ---- safety ----
# Read only for every AI app, fixed (the control center can't turn it off). on, yes, true or 1 mean on.
# ENCRYPTOR_READ_ONLY=yes

# ---- Mac ----
# off hides "Show in Finder" on a vault's page. Default: on
# ENCRYPTOR_FINDER=on

# ---- language ----
# The pages' language for every browser, like de, ja or pt-BR (docs/languages.md). Default: follow the browser
# ENCRYPTOR_LANGUAGE=de

# ---- the web version (encryptor-mcp serve, or Docker) ----
# The address people and AI apps use (must be https on the internet)
# ENCRYPTOR_DOMAIN=vault.example.com
# PUBLIC_URL=https://vault.example.com
# The passphrase for the control center and for connecting AI apps (8+ characters)
LOGIN_PASSPHRASE=
# or, instead, its hash from "encryptor-mcp set-passphrase":
# LOGIN_HASH=

# Where the server listens (Docker already sets these)
# HOST=127.0.0.1
# PORT=8767

# Websites allowed to receive an AI app's login. Setting this REPLACES the list, so keep the defaults when adding one
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com,vscode.dev

# ---- read from environment variables only (not from this file) ----
# ENCRYPTOR_CONFIG_DIR   the config folder (default ~/.config/encryptor-mcp, Docker /data)
# ENCRYPTOR_ENV_FILE     another settings file instead of this one
# ENCRYPTOR_DATA_DIR     the data folder (default <config folder>/state)
# ENCRYPTOR_APP_NAME     the app's name on the unlock page, when the AI app sends none
